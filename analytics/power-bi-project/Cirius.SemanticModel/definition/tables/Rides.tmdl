table Rides
	lineageTag: 76e65c0b-3e5a-4647-bf33-b4e5d77ac12b

	measure 'Published Rides' = COUNTROWS(Rides)
		formatString: #,##0
		lineageTag: 1dc299c9-fe69-4208-8a8d-5e0d85ad9289

	measure 'Completed Rides' = CALCULATE([Published Rides], KEEPFILTERS(Rides[ride_status] = "completed"))
		formatString: #,##0
		lineageTag: 347dd96b-e1cb-442d-9573-85f50a2887ee

	measure 'Cancelled Rides' = CALCULATE([Published Rides], KEEPFILTERS(Rides[ride_status] = "cancelled"))
		formatString: #,##0
		lineageTag: 57a66564-a808-4aa2-8785-d7a484b42126

	measure 'Offered Seats' = SUM(Rides[offered_seats])
		formatString: #,##0
		lineageTag: 961b4ddd-abed-42c1-837f-79473773a827

	measure 'Requested Seats' = SUM(Rides[requested_seats])
		formatString: #,##0
		lineageTag: ea118d6e-bf6a-4f82-b22c-fe1db73c6362

	measure 'Accepted Seats' = SUM(Rides[accepted_seats])
		formatString: #,##0
		lineageTag: 1cad6ec4-192d-4838-8df0-23ef394ef305

	measure 'Completed Seats' = SUM(Rides[completed_seats])
		formatString: #,##0
		lineageTag: cb7e4f21-06c6-496a-bb83-086d368240be

	measure 'Seat Utilization' = DIVIDE([Completed Seats], [Offered Seats])
		formatString: 0.0%
		lineageTag: d805d504-8d29-450f-80f5-9da2bcb8fda5

	measure 'Acceptance Rate' = DIVIDE([Accepted Seats], [Requested Seats])
		formatString: 0.0%
		lineageTag: 3e26d979-e149-46b8-8a57-244b4581aca4

	measure 'Seat Completion Rate' = DIVIDE([Completed Seats], [Accepted Seats])
		formatString: 0.0%
		lineageTag: 10ffc954-882a-4e8f-95c5-46fb61e0da8b

	measure 'Overall Conversion' = DIVIDE([Completed Seats], [Requested Seats])
		formatString: 0.0%
		lineageTag: 6d0331cc-9e12-4d9b-8462-7413826861f2

	measure 'Ride Cancellation Rate' = DIVIDE([Cancelled Rides], [Published Rides])
		formatString: 0.0%
		lineageTag: e767d95d-e2b7-4469-b934-e6e74157c573

	measure 'Demand Supply Ratio' = DIVIDE([Requested Seats], [Offered Seats])
		formatString: 0.0%
		lineageTag: 92b10dad-0322-4085-a593-69b2f540d2d1

	measure 'Gross Seat Value TND' = SUMX(Rides, Rides[completed_seats] * Rides[seat_value_tnd])
		formatString: #,##0.00
		lineageTag: 21ee0dcb-ec8b-4fad-9e87-62dbd28f4946

	measure 'Accepted Seat Value TND' = SUMX(Rides, Rides[accepted_seats] * Rides[seat_value_tnd])
		formatString: #,##0.00
		lineageTag: 8cafb24a-a999-4ce2-8e53-91cc8aa9e9c4

	measure 'Unrealized Accepted Value TND' = [Accepted Seat Value TND] - [Gross Seat Value TND]
		formatString: #,##0.00
		lineageTag: 0d6ac091-7d67-4b55-87be-00c9467125f3

	measure 'Unaccepted Seats' = [Requested Seats] - [Accepted Seats]
		formatString: #,##0
		lineageTag: f223ee7e-b6b4-42d3-8c0f-78d170f0b928

	measure 'Unfulfilled Accepted Seats' = [Accepted Seats] - [Completed Seats]
		formatString: #,##0
		lineageTag: ffd98ff7-d9dc-4804-bc0a-3c1404808972

	measure 'Booking Funnel Value' = SWITCH(SELECTEDVALUE('Booking Stages'[Stage]), "Requested seats", [Requested Seats], "Accepted seats", [Accepted Seats], "Completed seats", [Completed Seats])
		formatString: #,##0
		lineageTag: d02f0743-8656-417a-9261-7419e1490ddb

	measure 'Illustrative Fee TND' = [Gross Seat Value TND] * SELECTEDVALUE('Fee Scenarios'[Fee Rate])
		formatString: #,##0.00
		lineageTag: 25422d13-f0ff-451a-a73c-58c8e593a704

